# Local development: copy this file to .env.local and replace the placeholders.
# Use only a public publishable key (sb_publishable_...) or a legacy anon key.
# Do not place any high-privilege server key in a VITE_* variable.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=PASTE_YOUR_SUPABASE_PUBLISHABLE_KEY_HERE
# Optional backwards-compatibility variable; use the publishable-key name above for new setup.
# VITE_SUPABASE_ANON_KEY=PASTE_YOUR_LEGACY_ANON_KEY_HERE
